{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ]
    },
    "dooray": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${DOORAY_MCP_PATH}"
      ],
      "env": {
        "DOORAY_API_TOKEN": "${DOORAY_API_TOKEN}",
        "DOORAY_TENANT_URL": "${DOORAY_TENANT_URL}"
      }
    },
    "notion-work": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "NOTION_TOKEN": "${NOTION_WORK_API_TOKEN}"
      }
    },
    "notion-personal": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "NOTION_TOKEN": "${NOTION_PERSONAL_API_TOKEN}"
      }
    }
  }
}
